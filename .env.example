# LLM provider for TEXT GENERATION (drafts, rule proposals).
#   mock  = deterministic, offline, used by tests and by default in this repo
#   groq  = Groq-hosted Llama (OpenAI-compatible HTTP API)
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Triage backend: laya | llm | mock
#   laya = local Laya decision service (python -m uvicorn main:app --port 8080
#          from Slime/laya-service). Falls back to the LLM backend when down.
TRIAGE_BACKEND=laya
LAYA_URL=http://localhost:8080

# Confidence below this turns an engage/skip call into founder_decides
TRIAGE_CONFIDENCE_THRESHOLD=0.70
# Laya's choice probabilities run diffuse (calibrated 0.41-0.64 on correct picks)
LAYA_CONFIDENCE_THRESHOLD=0.50

# Drafting
MAX_DRAFTS=3
